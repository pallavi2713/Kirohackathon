# ============================================
# AI Government Scheme Navigator - Environment Variables
# ============================================
# Copy this file to .env and update with your actual values

# AWS Configuration
AWS_REGION=us-east-1
AWS_SERVICE=aoss

# OpenSearch Configuration
OPENSEARCH_HOST=your-opensearch-endpoint.us-east-1.aoss.amazonaws.com
OPENSEARCH_PORT=443
INDEX_NAME=scheme-index

# Bedrock Configuration
BEDROCK_MODEL_ID=amazon.titan-embed-text-v1
EMBEDDING_DIMENSION=1536

# Text Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Lambda S3 to EC2 Trigger Configuration
# EC2 instance URL where FastAPI ingestion service is running
EC2_API_URL=http://your-ec2-ip:8000/ingest
REQUEST_TIMEOUT=50

# Chatbot Lambda Configuration
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
LLM_MODEL_ID=amazon.nova-lite-v1:0
SEARCH_RESULTS_SIZE=3
KNN_K_VALUE=3
MAX_TOKENS=1000
TEMPERATURE=0.1
REWRITE_MAX_TOKENS=300

# Frontend Configuration
# API Gateway endpoint for the chatbot Lambda function
API_GATEWAY_ENDPOINT=https://your-api-id.execute-api.us-east-1.amazonaws.com/prod/ask

